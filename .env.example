# 复制成 .env 再填。这个文件本身可以进版本库，真的 .env 不行。

# ───────────── LLM（必填）─────────────
# 任何 OpenAI 兼容或 Anthropic 兼容的网关都可以。写稿是长输出任务，
# 建议用 ≥32k 上下文、支持长输出的模型。
LLM_PROTOCOL=openai
# 例：https://api.openai.com/v1   https://ark.cn-beijing.volces.com/api/v3
LLM_BASE_URL=https://your-gateway.example.com/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=your-model-id

# 限流与并发。网关通常有 QPS 限制；并发 8 在多数商业网关上可用。
LLM_MIN_INTERVAL_MS=0
LLM_MAX_CONCURRENCY=8
# 单次输出上限 / 整篇预算（超预算直接中断，避免跑飞烧钱）
LLM_MAX_TOKENS=8192
LLM_MAX_TOKENS_BUDGET=400000
LLM_MAX_CALLS=200

# 三类任务可以分别指定模型；留空回落到 LLM_MODEL
# DIGEST_LLM_MODEL=
# SCREEN_LLM_MODEL=
# REVIEW_LLM_MODEL=

# ───────────── 抓取 ─────────────
# arXiv / GitHub 请求的 UA。改成带你自己邮箱的形式更礼貌。
HTTP_USER_AGENT=paper-to-post/0.1 (+https://github.com/your-name/paper-to-post)
# 可选：GitHub 抓取量大会触发限流，配一个 token 能把配额从 60/h 提到 5000/h
GITHUB_TOKEN=

# ───────────── 发布：微信公众号 ─────────────
# 公众号后台 → 设置与开发 → 基本配置。
# 注意要把本机出口 IP 加进「IP 白名单」，否则拿 token 报 40164。
WECHAT_APPID=
WECHAT_APPSECRET=
# 文末作者名（公众号限制 8 字节，中文约 4 个字）
WECHAT_AUTHOR=

# ───────────── 发布：通用的 ─────────────
# 「阅读原文」指向你自己的站点根地址；不配则回退到 arXiv 原文链接。
# SITE_ORIGIN=https://example.com

# ───────────── 可选：浏览器路径 ─────────────
# Playwright 自带 chromium 时不用管；想用系统 Chrome 就指向它。
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
