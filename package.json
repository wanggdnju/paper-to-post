{
  "name": "paper-to-post",
  "version": "0.1.0",
  "private": false,
  "description": "From an arXiv link to a saved draft in the platform editor — research, write, verify, and fill in title, body, images, formulas and topics.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.18.0"
  },
  "keywords": [
    "arxiv",
    "llm",
    "paper-reading",
    "publishing",
    "zhihu",
    "wechat",
    "xiaohongshu"
  ],
  "scripts": {
    "publish": "node scripts/publish.mjs",
    "publish:check": "node scripts/publish-check.mjs",
    "fetch:all": "node scripts/prepare.mjs",
    "fetch:pdf": "node scripts/fetch-pdf.mjs",
    "fetch:figures": "node scripts/fetch-figures.mjs",
    "extract:links": "node scripts/extract-links.mjs",
    "render:table": "node scripts/render-table.mjs",
    "research:paper": "node scripts/research-paper.mjs",
    "briefing": "node scripts/briefing.mjs",
    "facts": "node scripts/facts.mjs",
    "glossary": "node scripts/glossary.mjs",
    "outline": "node scripts/outline.mjs",
    "generate": "node scripts/generate.mjs",
    "polish": "node scripts/polish.mjs",
    "critic": "node scripts/critic.mjs",
    "pipeline": "node scripts/pipeline.mjs",
    "qa": "node scripts/qa.mjs",
    "verify:numbers": "node scripts/verify-numbers.mjs",
    "verify:table": "node scripts/verify-table.mjs",
    "derive": "node scripts/derive-variants.mjs",
    "compare": "node scripts/compare.mjs",
    "diagram": "node scripts/diagram.mjs",
    "score": "node scripts/score.mjs",
    "regress": "node scripts/regress.mjs",
    "format:article": "node scripts/format-article.mjs",
    "render:html": "node scripts/render-html.mjs",
    "render:zhihu": "node scripts/render-zhihu.mjs",
    "render:wechat": "node scripts/render-wechat.mjs",
    "render:article": "node scripts/render-article.mjs",
    "finalize": "node scripts/finalize.mjs",
    "preview": "node scripts/preview.mjs",
    "serve:html": "node scripts/serve-html.mjs",
    "publish:platform": "node scripts/publish-platform.mjs",
    "publish:prompt": "node scripts/publish-prompt.mjs",
    "report": "node scripts/deliverable-report.mjs",
    "bench:llm": "node scripts/bench-llm.mjs",
    "latex:table": "node scripts/latex-table.mjs",
    "test": "node --test scripts/lib/*.test.mjs"
  },
  "dependencies": {
    "katex": "^0.18.10",
    "marked": "^18.1.3",
    "playwright": "^1.55.1",
    "qrcode": "^1.5.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wanggdnju/paper-to-post.git"
  },
  "homepage": "https://github.com/wanggdnju/paper-to-post#readme",
  "bugs": {
    "url": "https://github.com/wanggdnju/paper-to-post/issues"
  }
}
