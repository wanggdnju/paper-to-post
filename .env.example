# Copy to .env and fill in. This file is committed; the real .env is not.

# ───────────── LLM (required) ─────────────
# Any OpenAI-compatible or Anthropic-compatible endpoint works.
# Writing is a long-output task: use a model with at least 32k context
# and generous max output tokens.
LLM_PROTOCOL=openai
# e.g. https://api.openai.com/v1
#      https://ark.cn-beijing.volces.com/api/v3
LLM_BASE_URL=https://your-gateway.example.com/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=your-model-id

# Rate limiting. Most gateways enforce a QPS cap; concurrency 8 is usually safe.
LLM_MIN_INTERVAL_MS=0
LLM_MAX_CONCURRENCY=8
# Per-call output limit and per-article budget. Exceeding the budget aborts
# the run rather than continuing to spend.
LLM_MAX_TOKENS=8192
LLM_MAX_TOKENS_BUDGET=400000
LLM_MAX_CALLS=200

# Per-task model overrides; blank falls back to LLM_MODEL
# DIGEST_LLM_MODEL=
# SCREEN_LLM_MODEL=
# REVIEW_LLM_MODEL=

# ───────────── Fetching ─────────────
# User agent for arXiv and GitHub requests. Using a form with your contact
# address is preferred by both services.
HTTP_USER_AGENT=paper-to-post/0.1 (+https://github.com/your-name/paper-to-post)
# Optional. GitHub raises the rate limit from 60/h to 5000/h with a token.
GITHUB_TOKEN=

# ───────────── Publishing: WeChat MP ─────────────
# WeChat MP console → Settings and Development → Basic Configuration.
# The machine's egress IP must be on the IP allowlist, otherwise fetching a
# token fails with error 40164.
WECHAT_APPID=
WECHAT_APPSECRET=
# Author name shown in the article. WeChat limits this to 8 UTF-8 bytes
# (about four Chinese characters).
WECHAT_AUTHOR=

# ───────────── Publishing: general ─────────────
# Base URL of your own site, used for the "read original" link.
# Without it, the link falls back to the arXiv abstract page.
# SITE_ORIGIN=https://example.com

# ───────────── Optional: browser ─────────────
# Only needed to override the bundled Playwright Chromium.
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
